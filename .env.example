# ===========================================
# Asfar Trip — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your actual values.
# cp .env.example .env.local

# ---- Backend API ----
API_BASE_URL=your_api_base_url_here
NEXT_PUBLIC_API_BASE_URL=your_public_api_base_url_here
NEXT_PUBLIC_API_URL=your_public_api_url_here

# ---- API Credentials ----
TP_USERNAME=your_tp_username_here
TP_PASSWORD=your_tp_password_here

# ---- NextAuth.js ----
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000/

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---- Exchange Rate API ----
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# ---- Website ----
WEBSITE_URL=https://www.asfartrip.com
